{
  "name": "baby-on-screen",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "A tiny virtual baby companion for the Windows desktop.",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check app/main.cjs && node --check app/preload.cjs && node --check app/renderer.js && node --check engine.js",
    "build:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "author": "Hélio Conde",
  "license": "ISC",
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "br.com.helioconde.babyoncreen",
    "productName": "Baby On Screen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "engine.js",
      "sprits/**/*",
      "som/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Baby-On-Screen-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
